# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored, so your real key never leaves your machine.

# Free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Set to 1 to enable Flask debug mode (auto-reload, detailed errors). Leave unset in production.
# FLASK_DEBUG=1
